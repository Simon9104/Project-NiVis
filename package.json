{
  "name": "nivis-maplibre",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "fetch-osm": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-osm.ts",
    "build-dem": "NODE_USE_ENV_PROXY=1 tsx scripts/build-dem.ts",
    "build-style": "NODE_USE_ENV_PROXY=1 tsx scripts/build-style.ts",
    "screenshots": "node scripts/screenshots.cjs screenshots"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "maplibre-gl": "^6.17.0",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.187.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
